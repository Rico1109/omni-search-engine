# Gemini Embeddings Configuration
# Copy this to .env and add your Gemini API key

# Embedding Provider Selection
EMBEDDING_PROVIDER=gemini

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-embedding-001

# Embedding Dimensions (default: 768, max: 3072)
EMBEDDING_DIMENSIONS=768

# Task Type for Gemini (optimizes embedding quality)
# Options: RETRIEVAL_DOCUMENT, RETRIEVAL_QUERY, SEMANTIC_SIMILARITY, CLASSIFICATION, CLUSTERING
EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT

# Common Settings
EMBEDDING_BATCH_SIZE=100

# Vault Configuration
OBSIDIAN_VAULT_PATH=/mnt/c/MyLife

# ChromaDB Storage
CHROMADB_PATH=chroma_db

# Reranking (FlashRank)
RERANK_ENABLED=true
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Chunking Settings
TARGET_CHUNK_SIZE=1000
MAX_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=100
